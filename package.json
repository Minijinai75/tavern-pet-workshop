{
  "name": "tavern-pet-workshop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:loader": "tsc -p tsconfig.loader.json && vite build --config vite.loader.config.ts",
    "package:loader": "npm run build:loader && node scripts/package-loader.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.1",
    "vitest": "^3.2.4"
  }
}
